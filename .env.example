# ──────────────────────────────────────────────────────────────────────
# YouTube Live Streamer — environment variables
# Copy to `.env.local` for local dev, or set in the Vercel dashboard for
# production. Variables without NEXT_PUBLIC_ prefix are server-only and
# never exposed to the browser.
# ──────────────────────────────────────────────────────────────────────

# Your Mux API access token. Create one at https://dashboard.mux.com/settings/access-tokens
# Leave BOTH empty to run in DEMO MODE (no real upload / no real stream).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Optional: secret used to verify Mux webhook signatures (HMAC SHA-256).
# Configure this in the Mux dashboard webhook settings.
MUX_WEBHOOK_SIGNATURE_SECRET=

# Your YouTube Live stream key. Get it from YouTube Studio → Create → Go Live → Stream.
# CRITICAL: this is secret. NEVER expose it to the browser, the client bundle, or NEXT_PUBLIC_.
YOUTUBE_STREAM_KEY=
# Display-only name shown in the dashboard UI. Safe to expose.
YOUTUBE_CHANNEL_NAME=Connected YouTube channel

# Public URL of your deployed app. Used to set the Mux direct-upload CORS origin.
# Example: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
